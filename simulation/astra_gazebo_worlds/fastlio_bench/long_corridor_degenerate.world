<?xml version="1.0" ?>
<!--
  FAST-LIO baseline scene: long, deliberately feature-poor corridor.

  Corridor axis: +X.  The useful test interval is x = 0 -> 60 m.  At the
  starting point the two end walls are 100 m away (MID360 max range is 40 m),
  so scans contain only parallel walls, a floor and a ceiling.  This makes
  translation along X and yaw comparatively weakly observable.

  Do not add pillars, doors, signs, texture meshes or pedestrians to this
  world: each would turn it into a different, less-degenerate experiment.
-->
<sdf version="1.7">
  <world name="fastlio_long_corridor_degenerate">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.70 0.70 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.1 -0.95</direction>
    </light>

    <!-- One static model keeps all collision geometry self-contained. -->
    <model name="degenerate_corridor">
      <static>true</static>
      <!-- 200 m long; the endpoints must remain outside the MID360 range. -->
      <link name="structure">
        <collision name="floor_collision">
          <pose>0 0 -0.10 0 0 0</pose>
          <geometry><box><size>200 5.0 0.20</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.10 0 0 0</pose>
          <geometry><box><size>200 5.0 0.20</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material>
        </visual>

        <!-- Parallel side walls: they constrain Y/Z strongly but give little X structure. -->
        <collision name="left_wall_collision">
          <pose>0 2.50 2.00 0 0 0</pose>
          <geometry><box><size>200 0.20 4.0</size></box></geometry>
        </collision>
        <visual name="left_wall_visual">
          <pose>0 2.50 2.00 0 0 0</pose>
          <geometry><box><size>200 0.20 4.0</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
        <collision name="right_wall_collision">
          <pose>0 -2.50 2.00 0 0 0</pose>
          <geometry><box><size>200 0.20 4.0</size></box></geometry>
        </collision>
        <visual name="right_wall_visual">
          <pose>0 -2.50 2.00 0 0 0</pose>
          <geometry><box><size>200 0.20 4.0</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>

        <collision name="ceiling_collision">
          <pose>0 0 4.05 0 0 0</pose>
          <geometry><box><size>200 5.0 0.10</size></box></geometry>
        </collision>
        <visual name="ceiling_visual">
          <pose>0 0 4.05 0 0 0</pose>
          <geometry><box><size>200 5.0 0.10</size></box></geometry>
          <material><ambient>0.52 0.52 0.52 1</ambient><diffuse>0.52 0.52 0.52 1</diffuse></material>
        </visual>

        <!-- Safety end caps are 100 m away from the origin, not test features. -->
        <collision name="west_end_collision"><pose>-100 0 2 0 0 0</pose><geometry><box><size>0.20 5.0 4.0</size></box></geometry></collision>
        <visual name="west_end_visual"><pose>-100 0 2 0 0 0</pose><geometry><box><size>0.20 5.0 4.0</size></box></geometry></visual>
        <collision name="east_end_collision"><pose>100 0 2 0 0 0</pose><geometry><box><size>0.20 5.0 4.0</size></box></geometry></collision>
        <visual name="east_end_visual"><pose>100 0 2 0 0 0</pose><geometry><box><size>0.20 5.0 4.0</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
