<?xml version="1.0" ?>
<sdf version="1.6">
  <!--
    FAST-LIO loop-closure benchmark.
    The free 10 m x 10 m square in the centre is the UAV route.  Landmarks
    deliberately use different shapes/heights on every side, otherwise a
    symmetric arena can create convincing but false Scan Context matches.
  -->
  <world name="loop_closure_arena">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.80 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="asymmetric_loop_landmarks">
      <static>true</static>
      <link name="landmarks">
        <!-- Four boundary walls leave a large safety margin around the route. -->
        <collision name="wall_s_c"><pose>5 -5 2.0 0 0 0</pose><geometry><box><size>22 0.35 4</size></box></geometry></collision>
        <visual name="wall_s_v"><pose>5 -5 2.0 0 0 0</pose><geometry><box><size>22 0.35 4</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient></material></visual>
        <collision name="wall_n_c"><pose>5 15 2.0 0 0 0</pose><geometry><box><size>22 0.35 4</size></box></geometry></collision>
        <visual name="wall_n_v"><pose>5 15 2.0 0 0 0</pose><geometry><box><size>22 0.35 4</size></box></geometry><material><ambient>0.62 0.55 0.48 1</ambient></material></visual>
        <collision name="wall_w_c"><pose>-5 5 2.0 0 0 0</pose><geometry><box><size>0.35 20 4</size></box></geometry></collision>
        <visual name="wall_w_v"><pose>-5 5 2.0 0 0 0</pose><geometry><box><size>0.35 20 4</size></box></geometry><material><ambient>0.48 0.58 0.54 1</ambient></material></visual>
        <collision name="wall_e_c"><pose>15 5 2.0 0 0 0</pose><geometry><box><size>0.35 20 4</size></box></geometry></collision>
        <visual name="wall_e_v"><pose>15 5 2.0 0 0 0</pose><geometry><box><size>0.35 20 4</size></box></geometry><material><ambient>0.58 0.48 0.48 1</ambient></material></visual>

        <!-- South: low boxes, kept outside the flight corridor. -->
        <collision name="south_box_1_c"><pose>3 -2.3 0.8 0 0 0.25</pose><geometry><box><size>2.2 1.1 1.6</size></box></geometry></collision>
        <visual name="south_box_1_v"><pose>3 -2.3 0.8 0 0 0.25</pose><geometry><box><size>2.2 1.1 1.6</size></box></geometry><material><ambient>0.25 0.45 0.75 1</ambient></material></visual>
        <collision name="south_box_2_c"><pose>9 -2.5 1.4 0 0 -0.15</pose><geometry><box><size>1.4 1.3 2.8</size></box></geometry></collision>
        <visual name="south_box_2_v"><pose>9 -2.5 1.4 0 0 -0.15</pose><geometry><box><size>1.4 1.3 2.8</size></box></geometry><material><ambient>0.72 0.38 0.18 1</ambient></material></visual>

        <!-- East: three cylinders with deliberately different radii/heights. -->
        <collision name="east_pillar_1_c"><pose>12.6 1.8 1.5 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name="east_pillar_1_v"><pose>12.6 1.8 1.5 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>3.0</length></cylinder></geometry><material><ambient>0.75 0.65 0.18 1</ambient></material></visual>
        <collision name="east_pillar_2_c"><pose>13.0 5.5 2.4 0 0 0</pose><geometry><cylinder><radius>0.75</radius><length>4.8</length></cylinder></geometry></collision>
        <visual name="east_pillar_2_v"><pose>13.0 5.5 2.4 0 0 0</pose><geometry><cylinder><radius>0.75</radius><length>4.8</length></cylinder></geometry><material><ambient>0.68 0.25 0.25 1</ambient></material></visual>
        <collision name="east_pillar_3_c"><pose>12.4 9.2 1.0 0 0 0</pose><geometry><cylinder><radius>0.55</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="east_pillar_3_v"><pose>12.4 9.2 1.0 0 0 0</pose><geometry><cylinder><radius>0.55</radius><length>2.0</length></cylinder></geometry><material><ambient>0.30 0.65 0.38 1</ambient></material></visual>

        <!-- North: a stepped skyline. -->
        <collision name="north_step_1_c"><pose>1.5 12.5 0.6 0 0 0</pose><geometry><box><size>2.0 1.5 1.2</size></box></geometry></collision>
        <visual name="north_step_1_v"><pose>1.5 12.5 0.6 0 0 0</pose><geometry><box><size>2.0 1.5 1.2</size></box></geometry><material><ambient>0.42 0.32 0.65 1</ambient></material></visual>
        <collision name="north_step_2_c"><pose>4.2 12.5 1.3 0 0 0</pose><geometry><box><size>2.0 1.5 2.6</size></box></geometry></collision>
        <visual name="north_step_2_v"><pose>4.2 12.5 1.3 0 0 0</pose><geometry><box><size>2.0 1.5 2.6</size></box></geometry><material><ambient>0.42 0.32 0.65 1</ambient></material></visual>
        <collision name="north_step_3_c"><pose>7.0 12.5 2.1 0 0 0</pose><geometry><box><size>2.0 1.5 4.2</size></box></geometry></collision>
        <visual name="north_step_3_v"><pose>7.0 12.5 2.1 0 0 0</pose><geometry><box><size>2.0 1.5 4.2</size></box></geometry><material><ambient>0.42 0.32 0.65 1</ambient></material></visual>

        <!-- West: slanted blocks and one tall landmark near the start/finish. -->
        <collision name="west_tower_c"><pose>-2.5 1.5 2.8 0 0 0</pose><geometry><box><size>1.3 1.3 5.6</size></box></geometry></collision>
        <visual name="west_tower_v"><pose>-2.5 1.5 2.8 0 0 0</pose><geometry><box><size>1.3 1.3 5.6</size></box></geometry><material><ambient>0.18 0.55 0.65 1</ambient></material></visual>
        <collision name="west_slant_1_c"><pose>-2.5 6.0 1.1 0 0 0.55</pose><geometry><box><size>2.6 1.0 2.2</size></box></geometry></collision>
        <visual name="west_slant_1_v"><pose>-2.5 6.0 1.1 0 0 0.55</pose><geometry><box><size>2.6 1.0 2.2</size></box></geometry><material><ambient>0.25 0.68 0.52 1</ambient></material></visual>
        <collision name="west_slant_2_c"><pose>-2.3 10.0 1.8 0 0 -0.35</pose><geometry><box><size>1.2 2.4 3.6</size></box></geometry></collision>
        <visual name="west_slant_2_v"><pose>-2.3 10.0 1.8 0 0 -0.35</pose><geometry><box><size>1.2 2.4 3.6</size></box></geometry><material><ambient>0.72 0.55 0.20 1</ambient></material></visual>
      </link>
    </model>
  </world>
</sdf>
