Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.28
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 120; 170; 255
      Color Transformer: AxisColor
      Decay Time: 0.35
      Enabled: true
      Invert Rainbow: false
      Max Color: 220; 240; 255
      Min Color: 40; 80; 255
      Name: Current LiDAR scan (map frame)
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.025
      Style: Flat Squares
      Topic: /uav1/fastlio/registered_scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 70; 210; 120
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 70; 210; 120
      Min Color: 70; 210; 120
      Name: Clean global static map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Flat Squares
      Topic: /uav1/fastlio/cloud_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 205; 40
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 205; 40
      Min Color: 255; 205; 40
      Name: Rolling local obstacle map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05
      Style: Flat Squares
      Topic: /uav1/local_static_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.16
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 30; 220; 255
      Color Transformer: FlatColor
      Decay Time: 0.7
      Enabled: true
      Invert Rainbow: false
      Max Color: 30; 220; 255
      Min Color: 30; 220; 255
      Name: Observed local free space
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.025
      Style: Flat Squares
      Topic: /uav1/local_free_space
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.18
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 4
        Min Value: -1
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 160; 160; 160
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 160; 160; 160
      Min Color: 160; 160; 160
      Name: Raw FAST-LIO map (contains dynamic trails)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.02
      Style: Flat Squares
      Topic: /Laser_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 55; 40
      Color Transformer: FlatColor
      Decay Time: 0.6
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 55; 40
      Min Color: 255; 55; 40
      Name: Confirmed dynamic points
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.08
      Style: Spheres
      Topic: /uav1/dynamic_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 255
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.08
      Name: UAV flight path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 255; 255
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.2
      Topic: /uav1/fastlio/path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 80; 255
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.10
      Name: A-star planned path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 80; 255
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.2
      Topic: /uav1/planner/path
      Unreliable: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 145; 0
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.2
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.12
      Name: Local rolling planned path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 145; 0
      Pose Style: None
      Queue Size: 2
      Radius: 0.03
      Shaft Diameter: 0.08
      Shaft Length: 0.2
      Topic: /uav1/planner/local_path
      Unreliable: false
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.2
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.2
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: UAV pose
      Position Tolerance: 0.02
      Queue Size: 5
      Shape:
        Alpha: 1
        Axes Length: 0.8
        Axes Radius: 0.08
        Color: 255; 170; 0
        Head Length: 0.2
        Head Radius: 0.1
        Shaft Length: 0.5
        Shaft Radius: 0.05
        Value: Axes
      Topic: /uav1/fastlio/odom
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /uav1/dynamic_markers
      Name: Dynamic object markers
      Namespaces: {}
      Queue Size: 20
      Value: true
  Enabled: true
  Global Options:
    Background Color: 12; 12; 16
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 22
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785
      Focal Point:
        X: 0
        Y: 5
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.72
      Target Frame: map
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1440
