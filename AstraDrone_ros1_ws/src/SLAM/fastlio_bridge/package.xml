<?xml version="1.0"?>
<package format="2">
  <name>fastlio_bridge</name>
  <version>1.0.0</version>
  <description>FAST-LIO2 based indoor UAV dynamic obstacle perception and reactive avoidance.</description>
  <maintainer email="maintainer@example.com">project maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>message_filters</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <exec_depend>rospy</exec_depend>
  <!-- Demo runner tracks native rosbag record and validates its final index. -->
  <exec_depend>rosbag</exec_depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>roslib</exec_depend>
  <!-- Optional simulation relay imports these at runtime, not during C++ build. -->
  <exec_depend>pedsim_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <export/>
</package>
