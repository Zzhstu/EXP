<launch>
  <arg name="enable_control" default="true"/>
  <arg name="auto_arm" default="true"/>
  <arg name="auto_goal" default="true"/>
  <arg name="enable_semantic" default="false"/>
  <arg name="registered_cloud_topic" default="/cloud_registered"/>
  <arg name="rviz" default="true"/>
  <arg name="enable_path_planner" default="true"/>

  <!-- Align camera_init with MAVROS local ENU once.  Do not feed the aligned
       pose back into PX4 here, otherwise an estimator feedback loop is formed. -->
  <include file="$(find fastlio_bridge)/launch/perception.launch">
    <arg name="use_px4_initial_alignment" value="true"/>
    <arg name="publish_mavros_vision_pose" value="false"/>
    <arg name="enable_semantic" value="$(arg enable_semantic)"/>
    <arg name="registered_cloud_topic" value="$(arg registered_cloud_topic)"/>
  </include>

  <node pkg="fastlio_bridge" type="collision_risk_node" name="collision_risk" output="screen">
    <rosparam command="load" file="$(find fastlio_bridge)/config/dynamic_risk.yaml"/>
  </node>
  <node pkg="fastlio_bridge" type="static_collision_risk_node" name="static_collision_risk" output="screen">
    <rosparam command="load" file="$(find fastlio_bridge)/config/static_risk.yaml"/>
  </node>
  <node pkg="fastlio_bridge" type="avoidance_fusion_node" name="avoidance_fusion" output="screen">
    <rosparam command="load" file="$(find fastlio_bridge)/config/avoidance.yaml"/>
  </node>
  <node if="$(arg enable_path_planner)" pkg="fastlio_bridge"
        type="static_path_planner_node" name="static_path_planner" output="screen">
    <rosparam command="load" file="$(find fastlio_bridge)/config/path_planner.yaml"/>
  </node>
  <node pkg="fastlio_bridge" type="mavros_avoidance_controller_node"
        name="mavros_avoidance_controller" output="screen">
    <rosparam command="load" file="$(find fastlio_bridge)/config/astra_mavros_controller.yaml"/>
    <param name="enable_control" value="$(arg enable_control)"/>
    <param name="auto_arm" value="$(arg auto_arm)"/>
    <param name="auto_goal" value="$(arg auto_goal)"/>
    <param name="use_path_planner" value="$(arg enable_path_planner)"/>
  </node>
  <node pkg="fastlio_bridge" type="system_watchdog_node"
        name="dynamic_system_watchdog" output="screen"/>

  <!-- One RViz instance displays the map-aligned scan, accumulated final map,
       UAV trajectory and dynamic-obstacle diagnostics together. -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="dynamic_demo_rviz"
        args="-d $(find fastlio_bridge)/rviz/astra_dynamic_avoidance.rviz"/>
</launch>
