<launch>
  <!-- Local MID-360 mapping launch: avoids the duplicate fast_lio package name
       between ~/fastlio2 and ~/Prometheus. -->
  <arg name="uav_id" default="1"/>

  <rosparam command="load" file="$(find fastlio_bridge)/config/mid360_gazebo.yaml"/>
  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="point_filter_num" type="int" value="3"/>
  <param name="max_iteration" type="int" value="3"/>
  <param name="filter_size_surf" type="double" value="0.5"/>
  <param name="filter_size_map" type="double" value="0.5"/>
  <param name="cube_side_length" type="double" value="1000"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>
  <param name="filter_range_x" type="double" value="10"/>
  <param name="filter_range_y" type="double" value="10"/>
  <param name="filter_range_z" type="double" value="0.3"/>

  <remap from="/cloud_registered" to="/uav$(arg uav_id)/mid360_world_point"/>
  <remap from="/uav1/cloud_mid360_body" to="/uav$(arg uav_id)/mid360_lidar_point"/>
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>
</launch>
